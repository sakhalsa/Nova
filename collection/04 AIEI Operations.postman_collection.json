              ]
            }
          },
          "response": []
        },
        {
          "name": "Validate L Formula",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "",
                  "// Compute L-Score from mock reference data",
                  "",
                  "const L = 1 - (res.cycle_time_ai_hours / res.cycle_time_nonai_hours);",
                  "",
                  "",
                  "console.log(`L-Score computed: ${L.toFixed(4)}`);",
                  "",
                  "",
                  "// Validate stage segmentation",
                  "",
                  "const stages = res.stages || {};",
                  "",
                  "const itp = stages.ideation_to_pr || {};",
                  "",
                  "const rtm = stages.review_to_merge || {};",
                  "",
                  "const L_ideation_to_pr = itp.nonai_hours > 0 ? 1 - (itp.ai_hours /",
                  "itp.nonai_hours) : 0;",
                  "",
                  "const L_review_to_merge = rtm.nonai_hours > 0 ? 1 - (rtm.ai_hours /",
                  "rtm.nonai_hours) : 0;",
                  "",
                  "",
                  "console.log(`  L ideation_to_pr: ${L_ideation_to_pr.toFixed(4)}`);",
                  "",
                  "console.log(`  L review_to_merge: ${L_review_to_merge.toFixed(4)}`);",
                  "",
                  "",
                  "pm.test(\"L formula: expected ~0.3146 STRONG\", function () {",
                  "    // Assert L is approximately 0.3146 within tolerance",
                  "    pm.expect(Math.abs(L - 0.3146)).to.be.below(0.001,",
                  "        `L=${L.toFixed(4)} is not within 0.001 of expected 0.3146`);",
                  "",
                  "    // Assert classification is STRONG (L > 0.30)",
                  "    const classification = L > 0.30 ? \"STRONG\" :",
                  "                           L > 0.15 ? \"MODERATE\" : \"BOTTLENECK\";",
                  "    pm.expect(classification).to.eql(\"STRONG\",",
                  "        `Expected STRONG but got ${classification} for L=${L.toFixed(4)}`);",
                  "",
                  "    // Validate stage segmentation values are reasonable",
                  "    pm.expect(L_ideation_to_pr).to.be.within(-1, 1,",
                  "        \"ideation_to_pr L should be between -1 and 1\");",
                  "    pm.expect(L_review_to_merge).to.be.within(-1, 1,",
                  "        \"review_to_merge L should be between -1 and 1\");",
                  "});"
                ]
              }
            }
