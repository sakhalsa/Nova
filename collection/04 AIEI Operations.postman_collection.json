        {
          "name": "Validate Weight Profiles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reference component scores from benchmark",
                  "",
                  "const Q = 0.2483;",
                  "",
                  "const L = 0.3146;",
                  "",
                  "const R = 0.6962;",
                  "",
                  "const C_norm = 1.0;",
                  "",
                  "",
                  "// All 4 weight profiles",
                  "",
                  "const profiles = {",
                  "    quality_first:     { wQ: 0.35, wL: 0.20, wR: 0.35, wC: 0.10 },",
                  "    speed_first:       { wQ: 0.20, wL: 0.40, wR: 0.25, wC: 0.15 },",
                  "    reliability_first: { wQ: 0.20, wL: 0.20, wR: 0.45, wC: 0.15 },",
                  "    cost_first:        { wQ: 0.25, wL: 0.20, wR: 0.20, wC: 0.35 }",
                  "};",
                  "",
                  "",
                  "// Test each profile",
                  "",
                  "Object.keys(profiles).forEach(function (profileName) {",
                  "    const w = profiles[profileName];",
                  "    const weightSum = w.wQ + w.wL + w.wR + w.wC;",
                  "    const AIEI = (w.wQ * Q) + (w.wL * L) + (w.wR * R) + (w.wC * C_norm);",
                  "",
                  "    console.log(`${profileName}: weights sum=${weightSum.toFixed(2)}, AIEI=${AIEI.toFixed(4)}`);",
                  "",
                  "    pm.test(`${profileName} weights sum to 1.0 and AIEI in range`, function () {",
                  "        // Assert weights sum to 1.0",
                  "        pm.expect(Math.abs(weightSum - 1.0)).to.be.below(0.001,",
                  "            `${profileName} weights sum to ${weightSum}, expected 1.0`);",
                  "",
                  "        // Assert AIEI is within valid range [0, 1]",
                  "        pm.expect(AIEI).to.be.at.least(0,",
                  "            `${profileName} AIEI=${AIEI.toFixed(4)} is below 0`);",
                  "        pm.expect(AIEI).to.be.at.most(1,",
                  "            `${profileName} AIEI=${AIEI.toFixed(4)} is above 1`);",
                  "    });",
                  "});"
                ]
              }
            }
