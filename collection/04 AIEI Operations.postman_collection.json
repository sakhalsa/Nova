        {
          "name": "Validate C Formula",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "",
                  "// Compute C-Score from mock reference data",
                  "",
                  "const blended_rate = 150;",
                  "",
                  "const labor_value_saved = res.hours_saved_monthly * blended_rate;",
                  "",
                  "const overhead_value = res.review_overhead_hours_monthly * blended_rate;",
                  "",
                  "const total_ai_cost = res.token_cost_monthly + res.infra_cost_monthly +",
                  "res.tooling_cost_monthly;",
                  "",
                  "",
                  "const C_raw = (labor_value_saved - overhead_value) / total_ai_cost;",
                  "",
                  "const C_norm = Math.min(C_raw / 2.0, 1.0);",
                  "",
                  "",
                  "console.log(`C-Score computed:`);",
                  "",
                  "console.log(`  labor_value_saved: $${labor_value_saved.toFixed(2)}`);",
                  "",
                  "console.log(`  overhead_value: $${overhead_value.toFixed(2)}`);",
                  "",
                  "console.log(`  total_ai_cost: $${total_ai_cost.toFixed(2)}`);",
                  "",
                  "console.log(`  C_raw (ROI): ${C_raw.toFixed(4)}x`);",
                  "",
                  "console.log(`  C_norm: ${C_norm.toFixed(4)}`);",
                  "",
                  "",
                  "pm.test(\"C formula: expected ~2.80x ROI, C_norm=1.0\", function () {",
                  "    // Assert C_raw is approximately 2.7955 within tolerance",
                  "    pm.expect(Math.abs(C_raw - 2.7955)).to.be.below(0.01,",
                  "        `C_raw=${C_raw.toFixed(4)} is not within 0.01 of expected 2.7955`);",
                  "",
                  "    // Assert C_norm is 1.0",
                  "    pm.expect(Math.abs(C_norm - 1.0)).to.be.below(0.001,",
                  "        `C_norm=${C_norm.toFixed(4)} is not within 0.001 of expected 1.0`);",
                  "",
                  "    // Assert classification is POSITIVE (C_raw > 1.0)",
                  "    const classification = C_raw >= 1.0 ? \"POSITIVE\" :",
                  "                           C_raw >= 0.5 ? \"MARGINAL\" : \"NEGATIVE\";",
                  "    pm.expect(classification).to.eql(\"POSITIVE\",",
                  "        `Expected POSITIVE but got ${classification} for C_raw=${C_raw.toFixed(4)}`);",
                  "});"
                ]
              }
            }
          ],
