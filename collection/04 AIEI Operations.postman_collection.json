        {
          "name": "Validate Composite Formula",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Use hardcoded expected component scores from benchmark validation",
                  "",
                  "const Q = 0.2483;",
                  "",
                  "const L = 0.3146;",
                  "",
                  "const R = 0.6962;",
                  "",
                  "const C_norm = 1.0;",
                  "",
                  "",
                  "// Weights: reliability_first profile",
                  "",
                  "const wQ = 0.20;",
                  "",
                  "const wL = 0.20;",
                  "",
                  "const wR = 0.45;",
                  "",
                  "const wC = 0.15;",
                  "",
                  "",
                  "// Compute AIEI composite score",
                  "",
                  "const AIEI = (wQ * Q) + (wL * L) + (wR * R) + (wC * C_norm);",
                  "",
                  "",
                  "console.log(`Composite AIEI computed: ${AIEI.toFixed(4)}`);",
                  "",
                  "console.log(`  wQ(${wQ}) * Q(${Q}) = ${(wQ * Q).toFixed(4)}`);",
                  "",
                  "console.log(`  wL(${wL}) * L(${L}) = ${(wL * L).toFixed(4)}`);",
                  "",
                  "console.log(`  wR(${wR}) * R(${R}) = ${(wR * R).toFixed(4)}`);",
                  "",
                  "console.log(`  wC(${wC}) * C_norm(${C_norm}) = ${(wC *",
                  "C_norm).toFixed(4)}`);",
                  "",
                  "",
                  "pm.test(\"Composite formula: expected ~0.5759 OPTIMIZE WEAK COMPONENTS\",",
                  "function () {",
                  "    // Assert AIEI is approximately 0.5759 within tolerance",
                  "    pm.expect(Math.abs(AIEI - 0.5759)).to.be.below(0.001,",
                  "        `AIEI=${AIEI.toFixed(4)} is not within 0.001 of expected 0.5759`);",
                  "",
                  "    // Assert classification: OPTIMIZE WEAK COMPONENTS (0.40 < AIEI <= 0.70)",
                  "    let classification;",
                  "    if (AIEI > 0.70) {",
                  "        classification = \"AI-ENHANCED\";",
                  "    } else if (AIEI > 0.40) {",
                  "        classification = \"OPTIMIZE WEAK COMPONENTS\";",
                  "    } else {",
                  "        classification = \"RE-EVALUATE AI STRATEGY\";",
                  "    }",
                  "",
                  "    pm.expect(classification).to.eql(\"OPTIMIZE WEAK COMPONENTS\",",
                  "        `Expected OPTIMIZE WEAK COMPONENTS but got ${classification} for AIEI=${AIEI.toFixed(4)}`);",
                  "});"
                ]
              }
            }
